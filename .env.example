# Public browser configuration. Supabase publishable keys are intentionally
# public and are protected by database Row Level Security.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Keep demo mode off in every staging and production deployment.
VITE_CLINICFLOW_DEMO_MODE=false

# Configure this for each deployment/domain.
VITE_CLINICFLOW_APP_URL=http://localhost:3000

# Never add SUPABASE_SERVICE_ROLE_KEY to a VITE_* variable or commit it.
# Trusted workers and Edge Functions receive service credentials only through
# their deployment platform's encrypted secret store.

# Server-Side Email Service (Resend)
# Required for live invitation emails to Clinical Admins and staff:
RESEND_API_KEY=
# Sender email (must be a domain verified in Resend, or onboarding@resend.dev for testing):
EMAIL_FROM=ClinicFlow <onboarding@resend.dev>
# Canonical deployed URL of the application (ensures setup links never use localhost):
APP_URL=https://clinicflow.app

